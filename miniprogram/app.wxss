/**app.wxss**/
page {
  --primary: #7e57c2;
  --primary-light: #b39ddb;
  --primary-dark: #5e35b1;
  --accent: #ffb74d;
  --accent-dark: #ff8f00;
  --success: #66bb6a;
  --danger: #ef5350;
  --bg-card: #ffffff;
  --bg-page: #f7f5fb;
  --text-primary: #2c2c54;
  --text-secondary: #7575a0;
  --border: #ece9f5;

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(126, 87, 194, 0.08);
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(126, 87, 194, 0.3);
}

.btn-primary[disabled] {
  background: #cccccc;
  color: #ffffff;
  box-shadow: none;
}

.btn-accent {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 0, 0.3);
}

.btn-secondary {
  background: white;
  color: var(--primary);
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border: 2rpx solid var(--primary);
}

.text-primary { color: var(--primary); }
.text-accent { color: var(--accent-dark); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-secondary { color: var(--text-secondary); }

.flex {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt-12 { margin-top: 12rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }