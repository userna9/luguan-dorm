.page-lottery {
  padding: 40rpx 32rpx 64rpx;
}

.intro { padding: 0 8rpx; }
.intro-title {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}
.intro-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ===== 签筒 ===== */
.altar {
  margin-top: 36rpx;
  background: var(--tint);
  border-radius: 32rpx;
  padding: 56rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.draw-area {
  height: 440rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.tube {
  position: relative;
  width: 200rpx;
  height: 420rpx;
  transform-origin: 50% 100%;
}
.stick {
  position: absolute;
  bottom: 160rpx;
  left: 50%;
  width: 16rpx;
  height: 240rpx;
  margin-left: -8rpx;
  border-radius: 8rpx;
  background: linear-gradient(to bottom, var(--lamp) 0, var(--lamp) 34rpx, #d8bf93 34rpx);
  transform-origin: 50% 100%;
}
.s1 { transform: translateX(-52rpx) rotate(-12deg); height: 220rpx; }
.s2 { transform: translateX(-26rpx) rotate(-5deg); height: 250rpx; }
.s3 { transform: rotate(1deg); height: 262rpx; }
.s4 { transform: translateX(26rpx) rotate(6deg); height: 236rpx; }
.s5 { transform: translateX(52rpx) rotate(13deg); height: 214rpx; }
.tube-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 250rpx;
  background: var(--pine);
  border-radius: 12rpx 12rpx 28rpx 28rpx;
  box-shadow: inset -24rpx 0 0 rgba(0, 0, 0, 0.12);
}
.tube-rim {
  position: absolute;
  left: -10rpx;
  right: -10rpx;
  top: -6rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--pine-deep);
}
.tube-label {
  position: absolute;
  left: 50%;
  top: 64rpx;
  margin-left: -32rpx;
  width: 64rpx;
  padding: 14rpx 0;
  border-radius: 8rpx;
  border: 2rpx solid rgba(240, 180, 76, 0.55);
  text-align: center;
  font-size: 32rpx;
  line-height: 1.25;
  color: var(--lamp);
}

/* 摇晃动画（抽签中） */
.shake {
  animation: shake 0.42s ease-in-out 6;
}
@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-7deg); }
  75% { transform: rotate(7deg); }
}

/* ===== 签条 ===== */
.slip {
  width: 176rpx;
  height: 420rpx;
  background: #f7f1e2;
  border-radius: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 36rpx -18rpx rgba(31, 42, 37, 0.35);
}
.slip-inner {
  height: 100%;
  border: 2rpx solid rgba(46, 84, 70, 0.35);
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
  box-sizing: border-box;
}
.slip.leaf .slip-inner { border-color: rgba(168, 111, 62, 0.4); }
.slip-head {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--ink-2);
}
.slip-word {
  font-size: 120rpx;
  line-height: 1;
  color: var(--pine);
  font-weight: 600;
}
.slip-word.two {
  font-size: 88rpx;
  line-height: 1.1;
  text-align: center;
}
.slip.leaf .slip-word { color: var(--leaf); }
.slip-time {
  font-size: 22rpx;
  color: var(--ink-3);
}

.cta {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.cta-wait { color: var(--pine); }

/* ===== 今日分布 ===== */
.dist { padding: 36rpx 32rpx 28rpx; }
.dist-bar {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--tint);
}
.dist-seg { height: 100%; }
.dist-seg.deer { background: var(--pine); }
.dist-seg.leaf { background: var(--leaf); }
.dist-legend {
  display: flex;
  margin-top: 24rpx;
}
.legend {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-right: 56rpx;
}
.legend-key {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.legend-key.deer { background: var(--pine); }
.legend-key.leaf { background: var(--leaf); }
.legend-num {
  font-size: 34rpx;
  color: var(--ink);
  margin-left: 14rpx;
  line-height: 1;
}

.tabs { margin: 48rpx 0 24rpx; }

/* ===== 列表 ===== */
.list { padding: 0 32rpx; }
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.history-row .row-body { margin-left: 0; }
.row-name {
  font-size: 29rpx;
  color: var(--ink);
}
.row-time {
  font-size: 23rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

/* ===== 结果弹层 ===== */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 30, 26, 0.72);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.result-mask.show {
  opacity: 1;
  pointer-events: auto;
}
.result-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(60rpx);
  opacity: 0;
}
.result-mask.show .result-modal {
  transform: translateY(0);
  opacity: 1;
  transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2), opacity 0.4s;
}
.slip.big {
  width: 220rpx;
  height: 520rpx;
}
.slip.big .slip-word { font-size: 150rpx; }
.slip.big .slip-word.two { font-size: 110rpx; }
.result-text {
  margin-top: 48rpx;
  font-size: 30rpx;
  color: #f4ecd9;
  letter-spacing: 2rpx;
}
.result-close {
  margin-top: 40rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(244, 236, 217, 0.4);
  font-size: 26rpx;
  color: #f4ecd9;
}
