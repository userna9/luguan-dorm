.page-lottery {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* Hero */
.lottery-hero {
  position: relative;
  padding: 48rpx 32rpx 80rpx;
  margin-bottom: 32rpx;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 560rpx;
  background: linear-gradient(135deg, #ffb74d 0%, #ff8f00 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}
.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: white;
}
.lottery-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.lottery-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 32rpx;
}

/* 签筒 */
.stick-box {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18),
              inset 0 -8rpx 24rpx rgba(255, 143, 0, 0.2);
  border: 8rpx solid rgba(255, 255, 255, 0.6);
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}
.stick-box::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.6) 0%, transparent 50%);
  z-index: -1;
}
.stick-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.stick-emoji {
  font-size: 180rpx;
  animation: pulse 2s infinite;
}
.drawing-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff8f00;
  animation: pulse 1s infinite;
}
.result-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-emoji {
  font-size: 140rpx;
  margin-bottom: 12rpx;
}
.result-text {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.result-display.deer .result-text {
  color: #2e7d32;
}
.result-display.not-deer .result-text {
  color: #7575a0;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 摇晃动画 */
.shake {
  animation: shake 0.4s ease-in-out 6;
}
@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-8deg); }
  75% { transform: rotate(8deg); }
}

/* CTA */
.lottery-cta {
  text-align: center;
}
.cta-text {
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 16rpx 36rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(8rpx);
  display: inline-block;
}
.cta-text.done {
  background: rgba(255, 255, 255, 0.95);
  color: #5d4037;
  font-weight: 500;
}
.result-tag {
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin: 0 8rpx;
}
.tag-deer {
  background: rgba(46, 125, 50, 0.15);
  color: #2e7d32;
}
.tag-not-deer {
  background: rgba(117, 117, 144, 0.15);
  color: #5d4037;
}

/* 内容区 */
.content { padding: 0 32rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
  margin-bottom: 20rpx;
}

/* 统计 */
.stats-card {
  margin-bottom: 24rpx;
}
.stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 16rpx;
}
.stats-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cell-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c2c54;
}
.deer-color { color: #2e7d32; }
.not-deer-color { color: #8d6e63; }
.cell-label {
  font-size: 22rpx;
  color: #7575a0;
  margin-top: 4rpx;
}
.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background: #ece9f5;
}

.bar-chart {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f0edf7;
}
.deer-segment {
  background: linear-gradient(90deg, #66bb6a 0%, #43a047 100%);
  transition: width 0.6s;
}
.not-deer-segment {
  background: linear-gradient(90deg, #bcaaa4 0%, #8d6e63 100%);
  transition: width 0.6s;
}

/* Tab */
.tabs {
  display: flex;
  background: white;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(126, 87, 194, 0.08);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #7575a0;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.tab.active {
  background: linear-gradient(135deg, #ff8f00 0%, #ff6f00 100%);
  color: white;
  font-weight: 600;
}

/* 抽签列表 */
.lottery-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0edf7;
}
.lottery-item:last-child { border-bottom: none; }
.lottery-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0edf7;
}
.lottery-info { flex: 1; }
.lottery-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
}
.lottery-time {
  font-size: 22rpx;
  color: #7575a0;
  margin-top: 4rpx;
}
.lottery-result {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.lottery-result.deer {
  background: rgba(102, 187, 106, 0.15);
  color: #2e7d32;
}
.lottery-result.not-deer {
  background: rgba(141, 110, 99, 0.15);
  color: #5d4037;
}
.result-name {
  margin-left: 8rpx;
  font-size: 28rpx;
}

/* 历史 */
.history-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0edf7;
}
.history-row:last-child { border-bottom: none; }
.history-date {
  font-size: 26rpx;
  color: #7575a0;
  width: 200rpx;
}
.history-result {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}
.history-result.deer { color: #2e7d32; }
.history-result.not-deer { color: #5d4037; }
.history-time {
  font-size: 22rpx;
  color: #b0a8c0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 30rpx;
  color: #7575a0;
  margin-bottom: 8rpx;
}
.empty-tip {
  font-size: 24rpx;
  color: #b0a8c0;
}

/* 结果弹层 */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  padding: 48rpx;
}
.result-mask.show {
  opacity: 1;
  pointer-events: auto;
}
.result-modal {
  width: 100%;
  max-width: 560rpx;
  border-radius: 32rpx;
  overflow: hidden;
  transform: scale(0.8);
}
.result-mask.show .result-modal {
  transform: scale(1);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.result-modal-content {
  padding: 60rpx 48rpx;
  text-align: center;
}
.deer-modal {
  background: linear-gradient(135deg, #c8e6c9 0%, #a5d6a7 100%);
}
.not-deer-modal {
  background: linear-gradient(135deg, #d7ccc8 0%, #bcaaa4 100%);
}
.modal-emoji {
  font-size: 160rpx;
  margin-bottom: 16rpx;
}
.modal-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.deer-modal .modal-title { color: #1b5e20; }
.not-deer-modal .modal-title { color: #3e2723; }
.modal-text {
  font-size: 28rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}
.modal-time {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}
.modal-close {
  font-size: 22rpx;
  opacity: 0.5;
}