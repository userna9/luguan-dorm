.yard-page{padding:32rpx 28rpx 64rpx;background:#e4ece2;min-height:100vh;box-sizing:border-box;color:#163b2e}.eyebrow{font-size:23rpx;letter-spacing:2rpx;color:#5c7965}.yard-title{font-family:var(--serif);font-size:44rpx;font-weight:600;line-height:1.4;margin:12rpx 0 26rpx}.connection{background:#f6edcf;border:1rpx solid #e2cf98;padding:20rpx 24rpx;margin-bottom:22rpx;border-radius:16rpx;font-size:24rpx;color:#665a37}.connection-actions{display:flex;gap:16rpx;margin-top:14rpx}.connection button{margin:12rpx 0 0;font-size:24rpx;color:#2f6b52}.scene-wrap{position:relative;border-radius:28rpx;overflow:hidden;border:2rpx solid #ccdbc7;background:#deeadb}.yard-canvas{width:100%;height:690rpx;display:block}.speech{position:absolute;left:20%;right:20%;top:62%;text-align:center;background:#f6f9f3;padding:10rpx 16rpx;border:2rpx solid #2f6b52;font-size:23rpx;line-height:1.5;box-shadow:4rpx 4rpx 0 #9cb792;pointer-events:none}.scene-controls{display:flex;justify-content:space-between;align-items:center;padding:15rpx 20rpx;background:#d2e3ce;font-size:21rpx;color:#4a6855}.scene-controls view{padding:8rpx;border-bottom:1rpx solid #7fa88b}.pet-row{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0;padding:26rpx;background:#f6f9f3;border-radius:22rpx;gap:12rpx}.pet-name{font-size:36rpx;font-weight:650}.muted{font-size:23rpx;color:#64806c;margin-top:6rpx}.outline{padding:13rpx 22rpx;border:2rpx solid #2f6b52;border-radius:999rpx;background:transparent;font-size:24rpx;line-height:1.4;color:#2f6b52;margin:0;white-space:nowrap}.care-row{display:flex;gap:16rpx}.care{flex:1;background:#f6f9f3;border-radius:20rpx;padding:22rpx 0 18rpx;margin:0;font-size:28rpx;line-height:1.5;color:#163b2e}.care-pixel{display:flex;align-items:center;justify-content:center;width:54rpx;height:48rpx;background:#d2e3ce;color:#2f6b52;margin:0 auto 12rpx;box-shadow:6rpx 0 #b8ceb1,-6rpx 0 #b8ceb1;font-family:monospace;font-size:26rpx}.care-count{font-size:21rpx;color:#6f8574;margin-top:7rpx}.event-card{margin-top:24rpx;background:#f6f9f3;border-radius:24rpx;padding:30rpx}.event-title{font-size:31rpx;font-weight:600;margin:10rpx 0}.event-text{font-size:26rpx;line-height:1.8;color:#526c5b}.event-roles{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.event-roles button{font-size:23rpx;line-height:1.5;padding:15rpx 18rpx;border-radius:12rpx;background:#d2e3ce;color:#2f6b52;margin:0}.complete{margin-top:18rpx;color:#2f6b52;font-size:24rpx}.tree-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:24rpx;padding:16rpx 6rpx}.tree-row .outline{flex-shrink:0}.links{display:flex;justify-content:space-between;border-top:1rpx solid #c5d4bf;margin-top:28rpx;padding:30rpx 6rpx;font-size:25rpx}.links view{padding:12rpx 4rpx}.footnote{font-size:22rpx;color:#6b826f;text-align:center;line-height:1.7}.drawer-mask{position:fixed;inset:0;background:rgba(15,35,25,.45);z-index:99;display:flex;align-items:flex-end}.drawer{background:#f6f9f3;border-radius:32rpx 32rpx 0 0;max-height:75vh;padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}.drawer-head{display:flex;justify-content:space-between;font-size:32rpx;font-weight:600;padding-bottom:24rpx}.drawer-head view{font-size:25rpx;color:#64806c;padding:8rpx}.flower-row{display:flex;justify-content:space-between;align-items:center;padding:28rpx 0;border-top:1rpx solid #d2e3ce;font-size:27rpx}.memory{margin:18rpx 0;padding:28rpx;background:#e4ece2;border:1rpx solid #c5d4bf;font-size:27rpx;line-height:1.7}.memory-mark{font-size:21rpx;letter-spacing:3rpx;color:#64806c;margin-bottom:12rpx}.journal{padding:24rpx 0;border-top:1rpx solid #d2e3ce;font-size:27rpx;line-height:1.8}.journal .eyebrow{margin-bottom:10rpx}.empty-pane{padding:50rpx 16rpx;color:#64806c;font-size:27rpx}button[disabled]{opacity:.5}button::after{border:0}
