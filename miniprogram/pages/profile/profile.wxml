<view class="page-profile">
  <!-- 我 -->
  <view class="me">
    <image class="me-avatar" src="{{avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
    <view class="me-name serif">{{nickname || '还没设置昵称'}}</view>
    <view class="me-sub">鹿关宿舍成员</view>
    <view class="me-edit" bindtap="onEditProfile">编辑资料</view>
  </view>

  <!-- 回寝登记 -->
  <view class="section-head"><text class="h">回寝登记</text></view>
  <view class="sheet stats">
    <view class="figures">
      <view class="figure">
        <view class="figure-num serif">{{totalCheckins}}</view>
        <view class="figure-label">累计登记</view>
      </view>
      <view class="figure">
        <view class="figure-num serif lit">{{currentStreak}}</view>
        <view class="figure-label">连续天数</view>
      </view>
      <view class="figure">
        <view class="figure-num serif">{{longestStreak}}</view>
        <view class="figure-label">最长连续</view>
      </view>
    </view>
    <view class="meter">
      <view class="meter-head">
        <text>最近 7 天登记率</text>
        <text class="meter-val serif">{{checkinRate}}%</text>
      </view>
      <view class="meter-track">
        <view class="meter-fill lamp" style="width: {{checkinRate}}%"></view>
      </view>
    </view>
  </view>

  <!-- 抽签 -->
  <view class="section-head"><text class="h">鹿关抽签</text></view>
  <view class="sheet stats">
    <view class="figures">
      <view class="figure">
        <view class="figure-num serif">{{totalLottery}}</view>
        <view class="figure-label">累计抽签</view>
      </view>
      <view class="figure">
        <view class="figure-num serif deer">{{deerCount}}</view>
        <view class="figure-label">鹿</view>
      </view>
      <view class="figure">
        <view class="figure-num serif leaf">{{notDeerCount}}</view>
        <view class="figure-label">不鹿</view>
      </view>
    </view>
    <view class="meter" wx:if="{{totalLottery > 0}}">
      <view class="meter-head">
        <text>鹿运指数</text>
        <text class="meter-val serif">{{deerRate}}%</text>
      </view>
      <view class="meter-track leaf-track">
        <view class="meter-fill" style="width: {{deerRate}}%"></view>
      </view>
    </view>
  </view>

  <view class="colophon">六个人，一间屋</view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-mask {{keyboardUp ? 'keyboard-up' : ''}}" wx:if="{{showEditModal}}" bindtap="closeEditModal">
  <view class="modal-card" catchtap="noop">
    <view class="modal-title">编辑资料</view>
    <view class="modal-subtitle">改完点保存，室友那边会同步更新</view>

    <view class="form-item">
      <view class="form-label">头像</view>
      <view class="avatar-row">
        <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-large" src="{{avatarUrl || ''}}" wx:if="{{avatarUrl}}"></image>
          <view class="avatar-placeholder" wx:else>+</view>
        </button>
        <view class="avatar-side">
          <view class="avatar-tip">点圆形，用微信头像</view>
          <view class="avatar-album-link" bindtap="onPickAvatarFromAlbum">从相册选择</view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">昵称</view>
      <input
        class="nickname-input"
        type="text"
        placeholder="室友平时怎么叫你"
        value="{{nicknameInitial}}"
        maxlength="20"
        adjust-position="{{false}}"
        bindinput="onNicknameInput"
        bindfocus="onNicknameFocus"
        bindblur="onNicknameBlur"
      />
    </view>

    <view class="modal-buttons">
      <button class="btn-primary" bindtap="onSaveProfile">保存</button>
      <button class="btn-secondary" bindtap="closeEditModal">取消</button>
    </view>
  </view>
</view>
