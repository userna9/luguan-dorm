.page-profile {
  padding: 48rpx 32rpx 64rpx;
}

/* ===== 我 ===== */
.me {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.me-avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: var(--tint);
  border: 6rpx solid var(--sheet);
}
.me-name {
  margin-top: 28rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  letter-spacing: 2rpx;
}
.me-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.me-edit {
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: var(--tint);
  color: var(--pine);
  font-size: 25rpx;
  font-weight: 600;
}

/* ===== 数据 ===== */
.stats { padding: 36rpx 32rpx 32rpx; }
.figures { display: flex; }
.figure { flex: 1; }
.figure + .figure {
  border-left: 1rpx solid var(--line);
  padding-left: 32rpx;
}
.figure-num {
  font-size: 60rpx;
  line-height: 1.1;
  color: var(--ink);
}
.figure-num.lit { color: #c48a24; }
.figure-num.deer { color: var(--pine); }
.figure-num.leaf { color: var(--leaf); }
.figure-label {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.meter {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}
.meter-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 25rpx;
  color: var(--ink-2);
}
.meter-val {
  font-size: 34rpx;
  color: var(--ink);
}
.meter-track {
  margin-top: 16rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--tint);
  overflow: hidden;
}
.meter-track.leaf-track { background: var(--leaf-soft); }
.meter-fill {
  height: 100%;
  border-radius: 7rpx;
  background: var(--pine);
}
.meter-fill.lamp { background: var(--lamp); }

.colophon {
  margin-top: 72rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 6rpx;
}
