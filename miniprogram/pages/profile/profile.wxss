.page-profile {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* Hero */
.profile-hero {
  position: relative;
  padding: 32rpx 32rpx 80rpx;
  margin-bottom: 32rpx;
  /* 关键：把渐变背景裁在容器内。之前背景写死 360rpx 高于内容，溢出部分会盖住下面的「打卡数据」 */
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #7e57c2 0%, #5e35b1 100%);
  z-index: 0;
}
.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  color: white;
}
.big-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  background: white;
  margin-right: 24rpx;
}
.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.big-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.join-tip {
  font-size: 24rpx;
  opacity: 0.85;
}
.edit-btn {
  background: rgba(255, 255, 255, 0.25);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8rpx);
}

/* 章节 */
.section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(126, 87, 194, 0.08);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
  margin-bottom: 24rpx;
}

/* 数据 */
.data-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 16rpx;
}
.data-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.data-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c2c54;
}
.data-num.highlight {
  color: #7e57c2;
}
.deer-color { color: #2e7d32; }
.not-deer-color { color: #8d6e63; }
.data-label {
  font-size: 22rpx;
  color: #7575a0;
  margin-top: 4rpx;
}
.data-divider {
  width: 2rpx;
  height: 60rpx;
  background: #ece9f5;
}

.rate-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0edf7;
}
.rate-label {
  font-size: 26rpx;
  color: #7575a0;
  width: 240rpx;
}
.rate-progress {
  flex: 1;
  height: 16rpx;
  background: #f0edf7;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.rate-fill {
  height: 100%;
  background: linear-gradient(90deg, #7e57c2 0%, #5e35b1 100%);
  border-radius: 8rpx;
  transition: width 0.6s;
}
.rate-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #7e57c2;
  width: 80rpx;
  text-align: right;
}

.dual-info {
  font-size: 28rpx;
  color: #7575a0;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0edf7;
  text-align: center;
}
.highlight {
  color: #2e7d32;
  font-weight: 700;
}

/* Footer */
.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #b39ddb;
  margin-top: 32rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.modal-card {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 100%;
  max-width: 600rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c2c54;
  text-align: center;
  margin-bottom: 32rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #7575a0;
  margin-bottom: 12rpx;
}
.avatar-wrapper {
  background: transparent;
  border: none;
  padding: 0;
  display: block;
  width: 160rpx;
  height: 160rpx;
}
.avatar-wrapper::after {
  border: none;
}
.avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0edf7;
}
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0edf7;
  color: #b39ddb;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nickname-input {
  background: #f7f5fb;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
}
.nickname-input:focus {
  border-color: #7e57c2;
  background: white;
}
.modal-buttons {
  margin-top: 32rpx;
}
.modal-buttons .btn-primary,
.modal-buttons .btn-secondary {
  width: 100%;
}
/* 头像编辑：圆形按钮 + 右侧两个入口，横向排布，避免弹窗过高 */
.avatar-row {
  display: flex;
  align-items: center;
}
.avatar-side {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}
.avatar-tip {
  font-size: 24rpx;
  color: #9e9eb8;
  margin-bottom: 14rpx;
}
.avatar-album-link {
  font-size: 26rpx;
  color: #7e57c2;
  text-decoration: underline;
}

/* 键盘弹起时：把弹窗移到屏幕上方，避免被键盘顶出可视区域 */
.modal-mask.keyboard-up {
  align-items: flex-start;
  padding-top: 80rpx;
}
