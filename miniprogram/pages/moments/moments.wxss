.page-moments {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* ===== 发布入口 ===== */
.composer-bar {
  display: flex;
  align-items: center;
  background: var(--sheet);
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 12rpx;
}
.composer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--tint);
  flex-shrink: 0;
}
.composer-trigger {
  flex: 1;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: var(--ink-3);
}
.cancel-text {
  color: var(--pine);
  font-weight: 600;
}
.composer-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--pine);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.25s;
}
.composer-btn.open { transform: rotate(45deg); }
.composer-btn image {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 编辑面板 ===== */
.composer-panel {
  background: var(--sheet);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-top: 20rpx;
}
.content-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}

/* 图片九宫格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx -6rpx 0;
}
.image-cell {
  width: 196rpx;
  height: 196rpx;
  margin: 6rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
}
.preview-img {
  width: 100%;
  height: 100%;
}
.remove-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(20, 30, 26, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
.add-cell {
  background: var(--mist);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.add-icon {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--pine);
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}
.publish-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* ===== 动态 ===== */
.feed { margin-top: 32rpx; }
.empty-card {
  background: var(--sheet);
  border-radius: 28rpx;
}

.post-card {
  background: var(--sheet);
  border-radius: 28rpx;
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 20rpx;
}
.post-header {
  display: flex;
  align-items: center;
}
.post-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--tint);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.post-meta {
  flex: 1;
  min-width: 0;
}
.post-nickname {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}
.post-time {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.post-delete {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 8rpx 0 8rpx 16rpx;
}

.post-content {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.75;
  word-break: break-all;
}

/* 动态图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  margin: 18rpx -5rpx 0;
}
.post-img-cell {
  margin: 5rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--tint);
}
.images-1 .post-img-cell { width: 440rpx; height: 440rpx; border-radius: 16rpx; }
.images-2 .post-img-cell,
.images-4 .post-img-cell { width: 300rpx; height: 300rpx; }
.images-3 .post-img-cell,
.images-grid .post-img-cell { width: 197rpx; height: 197rpx; }
.post-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 操作 */
.post-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-2);
  padding: 10rpx 40rpx 10rpx 0;
}
.action-btn.liked { color: var(--rose); }
.action-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
}

/* 评论区 */
.comment-area {
  background: var(--mist);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-top: 12rpx;
}
.comment-row {
  font-size: 26rpx;
  line-height: 1.65;
  padding: 4rpx 0;
}
.comment-name {
  color: var(--pine);
  font-weight: 600;
}
.comment-text {
  color: var(--ink);
  word-break: break-all;
}
.comment-image {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
  background: var(--tint);
}

/* 评论输入 */
.comment-compose {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.comment-input-row {
  display: flex;
  align-items: center;
}
.comment-tool {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}
.comment-tool image {
  width: 40rpx;
  height: 40rpx;
}
.comment-tool.active { background: var(--tint); }
.comment-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  background: var(--mist);
  border-radius: 34rpx;
  padding: 0 24rpx;
  margin-left: 8rpx;
  font-size: 26rpx;
}
.comment-send {
  margin-left: 16rpx;
  background: var(--pine);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.comment-cancel {
  margin-left: 8rpx;
  color: var(--ink-3);
  font-size: 25rpx;
  padding: 14rpx 4rpx 14rpx 8rpx;
  flex-shrink: 0;
}
.comment-picked {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
}
.comment-picked-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--tint);
}
.comment-picked-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(20, 30, 26, 0.7);
  color: #fff;
  font-size: 30rpx;
}
.emoji-panel {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 12rpx 4rpx;
  background: var(--mist);
  border-radius: 16rpx;
}
.emoji-item {
  width: 12.5%;
  text-align: center;
  font-size: 40rpx;
  padding: 8rpx 0;
}

.feed-end {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
  padding: 32rpx 0 0;
}
