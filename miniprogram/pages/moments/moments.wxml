<view class="page-moments">

  <!-- 发布入口 -->
  <view class="composer-bar">
    <image class="composer-avatar" src="{{myAvatarUrl || 'images/profile.png'}}" mode="aspectFill"></image>
    <view class="composer-trigger" bindtap="toggleComposer">
      <text wx:if="{{!composing}}">分享宿舍动态…</text>
      <text wx:else class="cancel-text" bindtap="closeComposer">收起编辑 ▲</text>
    </view>
    <view class="composer-btn" bindtap="toggleComposer">✍️</view>
  </view>

  <!-- 编辑面板 -->
  <view class="composer-panel" wx:if="{{composing}}">
    <view class="panel-title">发布动态</view>
    <textarea
      class="content-input"
      placeholder="这一刻的想法…（宿舍趣事、吐槽、美食打卡都行）"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
      auto-height
    />

    <!-- 图片选择 -->
    <view class="image-grid">
      <view class="image-cell" wx:for="{{localImages}}" wx:key="*this">
        <image class="preview-img" src="{{item}}" mode="aspectFill"
               data-src="{{item}}" bindtap="onPreviewLocalImage"></image>
        <view class="remove-badge" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>
      <view class="image-cell add-cell" wx:if="{{localImages.length < maxImages}}" bindtap="onChooseImages">
        <view class="add-icon">+</view>
        <view class="add-text">{{localImages.length}}/{{maxImages}}</view>
      </view>
    </view>

    <button class="btn-primary publish-btn" bindtap="onPublish" disabled="{{publishing}}">
      {{publishing ? '发布中…' : '发布'}}
    </button>
  </view>

  <!-- 动态列表 -->
  <view class="feed">

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="empty">
      <view class="empty-icon">⏳</view>
      <view class="empty-text">加载中…</view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{posts.length === 0}}" class="empty empty-card">
      <view class="empty-icon">🛋️</view>
      <view class="empty-text">还没有动态</view>
      <view class="empty-tip">第一条宿舍动态由你来发！</view>
    </view>

    <!-- 动态卡片 -->
    <view class="post-card" wx:for="{{posts}}" wx:key="_id">
      <!-- 头部：头像+昵称+时间+删除 -->
      <view class="post-header">
        <image class="post-avatar" src="{{item.avatarUrl || 'images/profile.png'}}" mode="aspectFill"></image>
        <view class="post-meta">
          <view class="post-nickname">{{item.nickname}}</view>
          <view class="post-time">{{item.timeText}}</view>
        </view>
        <view class="post-delete" wx:if="{{item.isMine}}" data-id="{{item._id}}" bindtap="onDeletePost">删除</view>
      </view>

      <!-- 正文 -->
      <view class="post-content" wx:if="{{item.content}}">{{item.content}}</view>

      <!-- 图片 -->
      <view class="post-images images-{{item.images.length > 3 ? 'grid' : item.images.length}}"
            wx:if="{{item.images.length > 0}}">
        <view class="post-img-cell" wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
          <image class="post-img" src="{{img}}" mode="aspectFill"
                 data-id="{{item._id}}" data-index="{{imgIdx}}"
                 bindtap="onPreviewPostImage"></image>
        </view>
      </view>

      <!-- 评论区 -->
      <view class="comment-area" wx:if="{{item.comments.length > 0}}">
        <view class="comment-row" wx:for="{{item.comments}}" wx:for-item="c" wx:key="_id">
          <text class="comment-name">{{c.nickname}}：</text>
          <text class="comment-text" wx:if="{{c.content}}">{{c.content}}</text>
          <image class="comment-image" wx:if="{{c.imageUrl}}"
                 src="{{c.imageUrl}}" mode="aspectFill"
                 data-src="{{c.imageUrl}}" bindtap="onPreviewCommentImage"></image>
        </view>
      </view>

      <!-- 操作条 -->
      <view class="post-actions">
        <view class="action-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" bindtap="onToggleLike">
          <text class="action-icon">{{item.liked ? '❤️' : '🤍'}}</text>
          <text>{{item.likeCount > 0 ? item.likeCount : '赞'}}</text>
        </view>
        <view class="action-btn" data-id="{{item._id}}" bindtap="onShowCommentBox">
          <text class="action-icon">💬</text>
          <text>{{item.commentCount > 0 ? item.commentCount : '评论'}}</text>
        </view>
      </view>

      <!-- 评论输入区 -->
      <view class="comment-compose" wx:if="{{commentFor === item._id}}">
        <!-- 已选图片预览 -->
        <view class="comment-picked" wx:if="{{commentImage}}">
          <image class="comment-picked-img" src="{{commentImage}}" mode="aspectFill"
                 bindtap="onPreviewPickedImage"></image>
          <view class="comment-picked-del" catchtap="onRemoveCommentImage">×</view>
        </view>

        <view class="comment-input-row">
          <view class="comment-tool {{emojiOpen ? 'active' : ''}}" bindtap="onToggleEmoji">😊</view>
          <view class="comment-tool" bindtap="onPickCommentImage">🖼️</view>
          <input class="comment-input"
                 placeholder="友善评论，快乐宿舍…"
                 value="{{commentText}}"
                 maxlength="200"
                 bindinput="onCommentInput"
                 confirm-type="send"
                 bindconfirm="onSendComment"
                 focus="{{commentFor === item._id}}" />
          <view class="comment-send" bindtap="onSendComment">发送</view>
          <view class="comment-cancel" bindtap="onCancelComment">取消</view>
        </view>

        <!-- 表情面板 -->
        <view class="emoji-panel" wx:if="{{emojiOpen}}">
          <view class="emoji-item" wx:for="{{emojiList}}" wx:key="*this"
                data-emoji="{{item}}" bindtap="onPickEmoji">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="feed-end" wx:if="{{posts.length > 0}}">
    🦌 没有更多动态了
  </view>
</view>