.page-index {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部 Header */
.header {
  position: relative;
  padding: 32rpx 32rpx 80rpx;
  margin-bottom: 32rpx;
}
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(135deg, #7e57c2 0%, #5e35b1 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}
.header-content {
  position: relative;
  z-index: 1;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.user-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 20rpx;
  background: white;
}
.user-text {
  display: flex;
  flex-direction: column;
  color: white;
}
.greeting {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.date {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 统计行 */
.stats-row {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: white;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 功能卡片 */
.cards {
  padding: 0 32rpx;
}
.feature-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(126, 87, 194, 0.12);
  position: relative;
  overflow: hidden;
}
.checkin-card {
  background: linear-gradient(135deg, #f3e5f5 0%, #ffffff 70%);
}
.meal-card {
  background: linear-gradient(135deg, #fff3e0 0%, #ffffff 70%);
}
.meal-icon {
  background: rgba(255, 152, 0, 0.15);
}
.lottery-card {
  background: linear-gradient(135deg, #fff8e1 0%, #ffffff 70%);
}
.moments-card {
  background: linear-gradient(135deg, #e0f2f1 0%, #ffffff 70%);
}
.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}
.checkin-icon {
  background: rgba(126, 87, 194, 0.15);
}
.lottery-icon {
  background: rgba(255, 143, 0, 0.15);
}
.moments-icon {
  background: rgba(38, 166, 154, 0.15);
}
.card-content {
  flex: 1;
}
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2c54;
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 24rpx;
  color: #7575a0;
}
.card-arrow {
  font-size: 48rpx;
  color: #b39ddb;
  font-weight: 300;
}

/* 速览 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
  margin-bottom: 20rpx;
}
.overview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0edf7;
}
.overview-row:last-child {
  border-bottom: none;
}
.overview-label {
  font-size: 28rpx;
  color: #7575a0;
}
.overview-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.overview-name {
  font-size: 28rpx;
  color: #2c2c54;
  font-weight: 500;
}
.overview-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #7e57c2;
}
.overview-result {
  font-size: 28rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.result-deer {
  background: rgba(102, 187, 106, 0.15);
  color: #2e7d32;
}
.result-not-deer {
  background: rgba(239, 83, 80, 0.15);
  color: #c62828;
}
.overview-empty {
  font-size: 26rpx;
  color: #b0a8c0;
}

/* 提示 */
.tip {
  text-align: center;
  font-size: 24rpx;
  color: #b39ddb;
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.modal-card {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 100%;
  max-width: 600rpx;
}
.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2c2c54;
  text-align: center;
  margin-bottom: 12rpx;
}
.modal-subtitle {
  font-size: 24rpx;
  color: #7575a0;
  text-align: center;
  margin-bottom: 32rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #7575a0;
  margin-bottom: 12rpx;
}
.avatar-wrapper {
  background: transparent;
  border: none;
  padding: 0;
  display: block;
  width: 160rpx;
  height: 160rpx;
}
.avatar-wrapper::after {
  border: none;
}
.avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0edf7;
}
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0edf7;
  color: #b39ddb;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nickname-input {
  background: #f7f5fb;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
}
.nickname-input:focus {
  border-color: #7e57c2;
  background: white;
}
.modal-buttons {
  margin-top: 32rpx;
}
.modal-buttons .btn-primary {
  width: 100%;
}

/* ===== 吃饭询问弹窗 ===== */
.meal-modal {
  max-height: 80vh;
  overflow-y: auto;
}
.meal-tabs {
  display: flex;
  background: #f7f5fb;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.meal-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #7575a0;
  border-radius: 12rpx;
}
.meal-tab.active {
  background: linear-gradient(135deg, #ffb74d 0%, #ff8f00 100%);
  color: white;
  font-weight: 600;
}
.meal-creator {
  font-size: 24rpx;
  color: #7575a0;
  text-align: center;
  margin-bottom: 24rpx;
}
.meal-option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #f7f5fb;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.meal-option-label {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c54;
  font-weight: 500;
}
.meal-option-count {
  font-size: 24rpx;
  color: #7575a0;
  margin-right: 12rpx;
}
.meal-option-check {
  font-size: 24rpx;
  color: #2e7d32;
  font-weight: 600;
}
.meal-option.mine {
  background: rgba(102, 187, 106, 0.12);
  border-color: rgba(102, 187, 106, 0.5);
}
.meal-voters {
  font-size: 24rpx;
  color: #7575a0;
  padding: 8rpx 8rpx 0;
}
.meal-voters-label {
  color: #2c2c54;
  font-weight: 500;
}
.meal-empty {
  text-align: center;
  padding: 40rpx 0 16rpx;
}
.meal-empty-text {
  font-size: 26rpx;
  color: #7575a0;
  margin-bottom: 32rpx;
}
/* 头像编辑：圆形按钮 + 右侧两个入口，横向排布，避免弹窗过高 */
.avatar-row {
  display: flex;
  align-items: center;
}
.avatar-side {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}
.avatar-tip {
  font-size: 24rpx;
  color: #9e9eb8;
  margin-bottom: 14rpx;
}
.avatar-album-link {
  font-size: 26rpx;
  color: #7e57c2;
  text-decoration: underline;
}

/* 吃饭询问弹窗底部：转发到群 / 开启微信提醒 */
.meal-actions {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
}
.meal-actions button {
  flex: 1;
  margin: 0;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
  border-radius: 44rpx;
}
.meal-actions button::after {
  border: none;
}
.meal-actions button + button {
  margin-left: 16rpx;
}
.btn-share {
  background: #f3effa;
  color: #7e57c2;
  border: 1rpx solid #d9cff0;
}
.btn-remind {
  background: linear-gradient(135deg, #ff8f00 0%, #f57c00 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(255, 143, 0, 0.25);
}
.meal-copy-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9e9eb8;
  text-decoration: underline;
}

/* 键盘弹起时：把弹窗移到屏幕上方，避免被键盘顶出可视区域 */
.modal-mask.keyboard-up {
  align-items: flex-start;
  padding-top: 80rpx;
}
