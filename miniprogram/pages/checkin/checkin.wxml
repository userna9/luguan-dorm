<view class="page-checkin">
  <!-- 预计回寝时间：时间选择器包住整张卡片，选完自动保存 -->
  <view class="now">现在 <text class="now-time">{{currentTime}}</text></view>

  <picker mode="time" value="{{expectedTime}}" bindchange="onExpectedTimeChange">
    <view class="time-card {{isCheckedIn ? 'set' : ''}}">
      <view class="time-q">{{isCheckedIn ? '我今晚预计' : '今晚几点回宿舍？'}}</view>
      <view class="time-big serif">{{expectedTime}}</view>
      <view class="time-foot">
        <view class="time-lamp"></view>
        <text>{{isCheckedIn ? '已登记，室友都能看到。点一下可以改' : '点一下选时间，选好就自动登记'}}</text>
      </view>
    </view>
  </picker>

  <!-- 到宿舍了：点亮首页上自己的那扇窗 -->
  <view class="arrive {{myArrivedText ? 'done' : ''}}" bindtap="onArrive" hover-class="arrive-hover">
    <view class="arrive-window"></view>
    <view class="arrive-text">
      <view class="arrive-title">{{myArrivedText ? '已到宿舍' : '我到宿舍了'}}</view>
      <view class="arrive-sub">{{myArrivedText ? myArrivedText + ' 到的，点一下可撤销' : '点一下，首页上你的窗就会亮'}}</view>
    </view>
  </view>

  <view class="seg tabs">
    <view class="seg-item {{activeTab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="switchTab">回寝顺序</view>
    <view class="seg-item {{activeTab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">我的 7 天</view>
  </view>

  <!-- 回寝顺序 -->
  <view wx:if="{{activeTab === 'today'}}">
    <scroll-view scroll-x="true" class="date-scroll" enable-flex>
      <view wx:for="{{weekRange}}" wx:key="date"
            class="date-chip {{selectedDate === item.date ? 'active' : ''}}"
            data-date="{{item.date}}"
            bindtap="onSelectDate">
        <view class="chip-weekday">{{item.isToday ? '今天' : '周' + item.weekday}}</view>
        <view class="chip-day serif">{{item.day}}</view>
      </view>
    </scroll-view>

    <view class="sheet timeline">
      <view wx:if="{{todayCheckinList.length === 0}}" class="empty">
        <view class="empty-text">{{selectedDate === todayDate ? '今晚还没有人登记' : '这天没有人登记'}}</view>
        <view class="empty-tip" wx:if="{{selectedDate === todayDate}}">选个时间，做第一个亮灯的人</view>
      </view>

      <view wx:for="{{todayCheckinList}}" wx:key="_id" class="tl-row" data-item="{{item}}" bindtap="onItemTap">
        <view class="tl-time serif">{{item.timeText}}</view>
        <view class="tl-rail {{index === 0 ? 'first' : ''}} {{index === todayCheckinList.length - 1 ? 'last' : ''}}">
          <view class="tl-dot {{item.arrivedText ? 'arrived' : ''}}"></view>
        </view>
        <image class="avatar-sm" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
        <view class="tl-name">
          {{item.nickname}}<text wx:if="{{item._openid === openid}}" class="me-tag">我</text>
        </view>
        <view class="tl-note arrived" wx:if="{{item.arrivedText}}">{{item.arrivedText}} 已到</view>
        <view class="tl-note" wx:elif="{{index === 0 && todayCheckinList.length > 1}}">最早</view>
        <view class="tl-note late" wx:elif="{{index === todayCheckinList.length - 1 && todayCheckinList.length > 1}}">最晚</view>
      </view>
    </view>
  </view>

  <!-- 我的 7 天 -->
  <view wx:if="{{activeTab === 'history'}}" class="sheet week">
    <view wx:for="{{history}}" wx:key="date" class="day {{item.isToday ? 'today' : ''}}">
      <view class="day-weekday">{{item.isToday ? '今天' : '周' + item.weekday}}</view>
      <view class="day-num serif">{{item.day}}</view>
      <view class="day-window {{item.checked ? 'lit' : ''}}"></view>
      <view class="day-time {{item.checked ? '' : 'none'}}">{{item.time || '—'}}</view>
    </view>
  </view>
</view>
