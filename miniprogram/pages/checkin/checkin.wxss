.page-checkin {
  padding: 32rpx 32rpx 64rpx;
}

.now {
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.now-time {
  font-variant-numeric: tabular-nums;
  color: var(--ink-2);
}

/* ===== 预计回寝时间：夜林深色卡，登记后数字变成灯光色 ===== */
.time-card {
  margin-top: 20rpx;
  background: var(--pine-deep);
  border-radius: 32rpx;
  padding: 44rpx 44rpx 36rpx;
}
.time-q {
  font-size: 30rpx;
  color: #8fb39c;
}
.time-big {
  font-size: 168rpx;
  line-height: 1.1;
  color: #eaf1e6;
  letter-spacing: -2rpx;
  margin: 12rpx 0 20rpx -6rpx;
}
.time-card.set .time-big { color: var(--lamp); }
.time-foot {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8fb39c;
  border-top: 1rpx solid #2a5a47;
  padding-top: 24rpx;
}
/* 一扇小窗：登记前暗，登记后亮 */
.time-lamp {
  width: 20rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: none;
}
.time-card.set .time-lamp {
  display: block;
  background: var(--lamp);
  box-shadow: 0 0 16rpx rgba(240, 180, 76, 0.6);
}
.time-card.set .time-foot { color: #b9d2c2; }

/* ===== 我到宿舍了 ===== */
.arrive {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  background: var(--sheet);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: inset 0 0 0 2rpx var(--pine);
}
.arrive-hover { opacity: 0.7; }
.arrive-window {
  width: 44rpx;
  height: 56rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: var(--tint);
  box-shadow: inset 0 0 0 3rpx var(--moss);
  margin-right: 28rpx;
  flex-shrink: 0;
}
.arrive-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--pine);
}
.arrive-sub {
  font-size: 24rpx;
  color: var(--ink-3);
}
.arrive.done {
  background: var(--lamp-soft);
  box-shadow: none;
}
.arrive.done .arrive-window {
  background: radial-gradient(circle at 50% 38%, #ffeac0 0%, #f6c66a 45%, #e3a23c 100%);
  box-shadow: 0 0 20rpx rgba(240, 180, 76, 0.6);
}
.arrive.done .arrive-title { color: #8a5a12; }
.arrive.done .arrive-sub { color: #a37b3c; }

.tabs { margin: 48rpx 0 28rpx; }

/* ===== 日期 ===== */
.date-scroll {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  white-space: nowrap;
  height: 112rpx;
  margin-bottom: 24rpx;
}
.date-chip {
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 112rpx;
  box-sizing: border-box;
  margin-right: 12rpx;
  border-radius: 20rpx;
}
.chip-weekday {
  font-size: 21rpx;
  color: var(--ink-3);
}
.chip-day {
  font-size: 36rpx;
  line-height: 1.3;
  color: var(--ink-2);
}
.date-chip.active { background: var(--pine); }
.date-chip.active .chip-weekday { color: rgba(255, 255, 255, 0.7); }
.date-chip.active .chip-day { color: #fff; }

/* ===== 时间线 ===== */
.timeline { padding: 16rpx 32rpx; }
.tl-row {
  display: flex;
  align-items: center;
  height: 112rpx;
}
.tl-time {
  width: 112rpx;
  font-size: 34rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.tl-rail {
  position: relative;
  width: 24rpx;
  height: 100%;
  margin: 0 24rpx 0 8rpx;
}
.tl-rail::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: var(--line);
}
.tl-rail.first::before { top: 50%; }
.tl-rail.last::before { bottom: 50%; }
.tl-rail.first.last::before { display: none; }
.tl-dot {
  position: absolute;
  left: 4rpx;
  top: 50%;
  margin-top: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--sheet);
  box-shadow: inset 0 0 0 3rpx var(--pine);
}
/* 已到宿舍：这颗点亮灯 */
.tl-dot.arrived {
  background: var(--lamp);
  box-shadow: 0 0 0 6rpx var(--lamp-soft);
}
.tl-row .avatar-sm {
  width: 64rpx;
  height: 64rpx;
}
.tl-name {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 29rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-tag {
  font-size: 20rpx;
  color: var(--pine);
  background: var(--tint);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: 4rpx;
}
.tl-note {
  font-size: 22rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.tl-note.late { color: var(--leaf); }
.tl-note.arrived { color: #a37b3c; }

/* ===== 我的 7 天 ===== */
.week {
  display: flex;
  justify-content: space-between;
  padding: 36rpx 20rpx 32rpx;
}
.day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.day-weekday {
  font-size: 21rpx;
  color: var(--ink-3);
}
.day-num {
  font-size: 34rpx;
  color: var(--ink-2);
  line-height: 1.4;
}
.day.today .day-num { color: var(--ink); font-weight: 600; }
.day-window {
  width: 44rpx;
  height: 56rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: var(--tint);
  margin: 18rpx 0 14rpx;
}
.day-window.lit {
  background: var(--lamp);
  box-shadow: 0 0 20rpx rgba(240, 180, 76, 0.5);
}
.day-time {
  font-size: 21rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.day-time.none { color: var(--ink-3); }
