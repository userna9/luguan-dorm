.page-checkin {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* Hero 区域 */
.checkin-hero {
  position: relative;
  padding: 32rpx 32rpx 80rpx;
  margin-bottom: 32rpx;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 480rpx;
  background: linear-gradient(135deg, #9575cd 0%, #5e35b1 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}
.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: white;
}
.current-time {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  font-family: "Courier New", monospace;
  margin-bottom: 8rpx;
}
.checkin-date {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 32rpx;
}

.big-check-btn {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 8rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
}
.big-check-btn::after {
  border: none;
}
.big-check-btn.checked {
  background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%);
  border-color: rgba(102, 187, 106, 0.4);
}
.big-check-btn.checked .big-check-text,
.big-check-btn.checked .big-check-time {
  color: white;
}
.big-check-icon {
  font-size: 88rpx;
  margin-bottom: 12rpx;
}
.big-check-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #5e35b1;
}
.big-check-time {
  font-size: 26rpx;
  color: #5e35b1;
  margin-top: 8rpx;
}
.big-check-tip {
  font-size: 22rpx;
  color: #9e97c0;
  margin-top: 8rpx;
}
.big-check-btn.checked .big-check-tip {
  color: rgba(255, 255, 255, 0.85);
}

.checkin-status {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(8rpx);
}
.checkin-status.hint {
  background: rgba(255, 255, 255, 0.15);
}

/* Tab */
.tabs {
  display: flex;
  background: white;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(126, 87, 194, 0.08);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #7575a0;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.tab.active {
  background: linear-gradient(135deg, #7e57c2 0%, #5e35b1 100%);
  color: white;
  font-weight: 600;
}

/* 内容区 */
.content {
  padding: 0 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
  margin-bottom: 20rpx;
}

/* 排行 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0edf7;
}
.rank-item:last-child {
  border-bottom: none;
}
.rank-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0edf7;
  color: #7575a0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 20rpx;
}
.rank-no.top {
  background: linear-gradient(135deg, #ffb74d 0%, #ff8f00 100%);
  color: white;
}
.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0edf7;
}
.rank-info {
  flex: 1;
}
.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c54;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.me-tag {
  background: #7e57c2;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: normal;
}
.rank-time {
  font-size: 24rpx;
  color: #7575a0;
  margin-top: 4rpx;
}
.rank-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(102, 187, 106, 0.15);
  color: #2e7d32;
  border-radius: 16rpx;
}
.rank-badge.rank-late {
  background: rgba(255, 183, 77, 0.15);
  color: #ef6c00;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 30rpx;
  color: #7575a0;
  margin-bottom: 8rpx;
}
.empty-tip {
  font-size: 24rpx;
  color: #b0a8c0;
}

/* 日期选择 */
.date-tabs {
  margin-top: 32rpx;
}
.date-tip {
  font-size: 24rpx;
  color: #7575a0;
  text-align: center;
  margin-bottom: 16rpx;
}
.date-scroll {
  white-space: nowrap;
  width: 100%;
}
.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 110rpx;
  background: white;
  border-radius: 20rpx;
  margin-right: 12rpx;
  border: 2rpx solid #ece9f5;
}
.date-chip.active {
  background: linear-gradient(135deg, #7e57c2 0%, #5e35b1 100%);
  border-color: transparent;
  color: white;
}
.chip-weekday {
  font-size: 22rpx;
  margin-bottom: 4rpx;
  color: #7575a0;
}
.date-chip.active .chip-weekday {
  color: rgba(255, 255, 255, 0.9);
}
.chip-day {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c54;
}
.date-chip.active .chip-day {
  color: white;
}

/* 历史 */
.history-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0edf7;
}
.history-row:last-child {
  border-bottom: none;
}
.history-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}
.history-day {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c2c54;
}
.history-weekday {
  font-size: 22rpx;
  color: #7575a0;
}
.history-status {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 24rpx;
}
.history-status.checked {
  background: rgba(102, 187, 106, 0.15);
  color: #2e7d32;
}
.history-status.missed {
  background: rgba(239, 83, 80, 0.12);
  color: #c62828;
}
.history-time {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #7575a0;
}